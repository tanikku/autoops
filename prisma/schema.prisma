// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A signed-in Google account. `id` is the provider account id (the JWT `sub`),
/// which is what every owned row is scoped by.
model User {
  id             String            @id
  email          String            @unique
  name           String?
  image          String?
  /// IANA zone the dashboard renders timestamps in, e.g. "Asia/Tokyo".
  ///
  /// Defaults to Asia/Tokyo because that is where the Closed Beta's users are:
  /// an account that never opens Settings and asks for 09:00 means 09:00 where
  /// it is, not 09:00 UTC. **This is an initial value, not a policy** — UTC is
  /// still one of `supportedTimezones`, and an account that chooses it keeps it.
  ///
  /// **Only rows created after the default changed are affected.** Existing
  /// rows were not rewritten, and could not have been: nothing distinguishes a
  /// row that took the old default from one whose owner chose UTC on purpose.
  timezone       String            @default("Asia/Tokyo")
  /// Language AutoOps uses for its own screens, "en" or "ja".
  ///
  /// A plain string rather than a database enum: adding a language should be a
  /// dictionary file and a line in `supportedLanguages`, not a migration. The
  /// application narrows it on the way in and falls back on the way out, the
  /// same as `status` and `frequency` do.
  ///
  /// **It says nothing about what a worker produces.** Instructions, watched
  /// pages and model output are the owner's own material and are never
  /// translated to match this.
  language       String            @default("en")
  createdAt      DateTime          @default(now())
  routines       Routine[]
  runs           RunHistory[]
  rateLimits     RateLimitBucket[]
  manualRunSlots ManualRunSlot[]

  /// **The Creator side of the account, and it is a separate side.** None of
  /// these is reachable from a `Routine`, and none of them reaches one: a
  /// worker runs on a schedule and writes a `RunHistory`, while what follows
  /// is material somebody handed over and the decisions made about it. They
  /// share an owner and nothing else.
  ///
  /// **Every one of them is listed here so that deleting an account takes
  /// them with it.** The cascade is declared on the far side; these fields are
  /// what make the relation exist at all, and they add no column to this table.
  creatorProfile     CreatorProfile?
  contentItems       ContentItem[]
  editorialDecisions EditorialDecision[]
  contentDrafts      ContentDraft[]
  creatorFeedback    CreatorFeedback[]
  /// **A list, though an account has at most one.** What holds it to one is
  /// the chain — `CreatorProfile.userId` is unique and
  /// `CreatorMemory.creatorProfileId` is unique — rather than a constraint on
  /// this column, which carries an ordinary index. Declaring the relation
  /// one-to-one here would claim a uniqueness the database is not being asked
  /// to enforce.
  creatorMemories    CreatorMemory[]
  memoryEvidence     CreatorMemoryEvidence[]

  /// **What the account is entitled to, and what it has spent.** None of these
  /// is read by anything that runs a worker: the tables exist so the decisions
  /// about billing have somewhere to land before anything acts on them.
  ///
  /// Listed here for the same reason as the Creator side above — deleting an
  /// account takes them with it, and the cascade is declared on the far side.
  subscription           Subscription?
  usagePeriods           UsagePeriod[]
  providerUsageEvents    ProviderUsageEvent[]
  billingEvents          BillingEvent[]
  providerEventReceipts  ProviderEventReceipt[]
  billingReconciliations BillingReconciliation[]
}

model Routine {
  id                  String         @id @default(cuid())
  userId              String
  name                String
  description         String         @default("")
  prompt              String         @default("")
  /// What kind of worker this is: `prompt` sends its prompt to the model,
  /// `website` fetches a page first and only involves the model when the page
  /// changed.
  ///
  /// **A plain string, narrowed in `toRoutine`, exactly as `status` and
  /// `frequency` are.** The alternative — an enum — would be the first in this
  /// schema and would make adding a kind a migration rather than a line in a
  /// type guard.
  ///
  /// The default is what makes this additive: every worker that existed before
  /// watchers did is a `prompt` worker, and Postgres fills them in without a
  /// backfill.
  kind                String         @default("prompt")
  status              String         @default("draft")
  frequency           String         @default("manual")
  /// Time of day the worker runs, as minutes into the day in the owner's
  /// timezone: 0 is midnight, 540 is 09:00. Null keeps whatever time the
  /// pending slot already had, which is how every worker behaved before a time
  /// could be chosen.
  runAtMinutes        Int?
  /// Day of the week a weekly worker runs, in the owner's timezone: 0 is
  /// Sunday through 6 is Saturday, matching JavaScript's own numbering so no
  /// conversion sits between this column and the arithmetic. Null keeps
  /// whichever weekday the pending slot already falls on.
  runAtWeekday        Int?
  /// Day of the month a monthly worker runs, in the owner's timezone: 1 to 31.
  /// A day past the end of a month runs on that month's last day instead, and
  /// the month after returns to the chosen one. Null keeps whichever day the
  /// pending slot already falls on.
  runAtDay            Int?
  nextRunAt           DateTime?
  /// Whether AutoOps emails the owner about this worker's runs.
  ///
  /// **Per worker, and off unless somebody turned it on.** The default is what
  /// makes this additive: every worker that existed before notifications did
  /// keeps behaving exactly as it did, and Postgres fills the column in without
  /// a backfill.
  ///
  /// **It says whether to send, not where.** There is no address here — the
  /// recipient is the owner of the routine, read from `User.email` at the
  /// moment a run finishes, so a worker cannot carry a destination of its own.
  // Left unaligned with the block above on purpose: this name is longer than
  // the column those share, and re-padding twenty untouched lines to fit it
  // would put unrelated churn in the same diff.
  emailNotificationsEnabled Boolean @default(false)
  /// Who currently holds the right to execute this worker, as an opaque token
  /// minted per acquisition. Null means nobody does.
  ///
  /// **Execution ownership, not the scheduled slot.** `nextRunAt` says which
  /// slot has been taken; this says whether a run is already under way, and it
  /// applies to hand-started runs as much as to scheduled ones.
  ///
  /// It is neither a job id nor an execution id, and nothing outside the lease
  /// primitive reads it — a run is identified by its `RunHistory` row.
  executionOwner      String?
  /// When the current holder's claim lapses, after which another may take it.
  ///
  /// **Expiry is what keeps a lost process from blocking a worker forever.** A
  /// run that dies without releasing leaves the columns set; the next attempt
  /// takes over once this instant has passed. Nothing sweeps them.
  ///
  /// The consequence is that this is *not* an unconditional guarantee of one
  /// execution at a time: a run outliving its lease can overlap with the one
  /// that takes over. What is guaranteed is that the older holder cannot
  /// release the newer one's claim — see `lib/execution-lease.ts`.
  executionLeaseUntil DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs                RunHistory[]
  /// The watched page, when this is a `website` worker. Absent on every other
  /// kind, which is why the relation is optional rather than the `kind` column
  /// being the only thing that says so.
  websiteSource       WebsiteSource?
  /// What to look for, when this is a `discovery` worker. Optional for the same
  /// reason `websiteSource` is: the relation says which workers have one, and
  /// the `kind` column is not the only thing standing behind that.
  ///
  /// **Nothing reads this yet.** The kind it belongs to is not in
  /// `routineKinds`, so no worker can be saved as one — see the note on
  /// `DiscoverySource`.
  discoverySource     DiscoverySource?
  discoverySeenItems  DiscoverySeenItem[]

  @@index([userId])
  /// The scheduler's only query: `status = 'active' AND nextRunAt <= now()`,
  /// ordered by `nextRunAt`. Equality first and the range second is what lets
  /// one index serve both the filter and the ordering — reversed, the range
  /// column would stop the scan from using `status` to narrow anything.
  ///
  /// Every tick runs this across all tenants, so without an index the cost
  /// grows with the number of workers on the platform rather than with the
  /// number that are due.
  @@index([status, nextRunAt])
}

model RunHistory {
  id           String    @id @default(cuid())
  routineId    String
  /// Denormalised from the routine so runs can be scoped without a join.
  userId       String
  status       String    @default("running")
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  /// What the model produced. **Only ever that** — a run that failed leaves it
  /// empty rather than borrowing it for a reason.
  output       String    @default("")
  /// Why a run failed, for whoever is looking into it. Null on every run that
  /// did not fail, which is what makes the two columns readable without
  /// consulting `status` first.
  ///
  /// **A diagnostic, not a message written for the person whose worker it
  /// is.** It carries whatever the failure said — a provider's own wording, or
  /// a database driver's — so it belongs on the execution's own page and not
  /// in a list someone is scanning.
  errorMessage String?
  routine      Routine   @relation(fields: [routineId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([routineId])
  @@index([userId])
}

/// The page a `website` worker watches, and the settings for watching it.
///
/// **Configuration, and only configuration.** What was last seen there lives in
/// `WebsiteSnapshot`, which is a separate table for a reason: this row is small,
/// edited by a person, and read whenever a worker is shown, while that one holds
/// up to a couple of megabytes and is read only while a run is happening.
/// Together in one table, every screen that wanted the URL would carry the page
/// with it.
///
/// One row per worker at most — `routineId` is unique — so a worker watches one
/// page. Several workers watching the same page, in one account or across
/// accounts, is ordinary, which is why `url` carries no unique constraint.
///
/// **There is no owner column here, deliberately.** `RunHistory` carries one
/// because runs are listed per account and the join would be on every activity
/// page; nothing lists sources that way, so the same denormalisation would buy
/// nothing and would make `Routine.userId = A` with `WebsiteSource.userId = B`
/// a state the database is willing to hold. Ownership has one source of truth,
/// and it is the routine.
model WebsiteSource {
  id        String           @id @default(cuid())
  /// Unique because a worker watches one page. The relation being optional on
  /// the other side is what lets a `prompt` worker have none. **It is also the
  /// tenant key**: who owns this is whoever owns the routine.
  routineId String           @unique
  /// The address as the owner wrote it. **Validated when it is saved and again
  /// before every fetch** — storing it is not a promise that it is still safe
  /// to visit, and nothing here may be fetched without going through
  /// `lib/watcher`.
  url       String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  routine   Routine          @relation(fields: [routineId], references: [id], onDelete: Cascade)
  snapshot  WebsiteSnapshot?
}

/// What the watched page looked like when it was last successfully read.
///
/// **The baseline a change is measured against, and nothing else.** It is not
/// run history: there is one row per source, overwritten in place, so watching a
/// page for a year costs the same as watching it for a day. A table of every
/// version would grow without limit and would need a retention policy that
/// nothing has decided.
///
/// **The row does not exist until the first successful fetch.** That absence is
/// the "no baseline yet" state — there is no half-made snapshot to represent,
/// which is why the only nullable column here is one with a meaning of its own.
///
/// **`RunHistory.output` is not this.** That column holds what the model
/// produced; this holds what the site served. Reading a snapshot out of run
/// history would also lose it on the first failed run.
model WebsiteSnapshot {
  id                String        @id @default(cuid())
  websiteSourceId   String        @unique
  /// The page reduced to the text a comparison runs on — **not raw HTML**,
  /// which is deliberately never stored: it is larger, and none of the
  /// comparison or the summary needs it.
  ///
  /// `String` is `TEXT` on PostgreSQL, so the ceiling is the fetch limit
  /// (`MAX_RESPONSE_BYTES`) rather than anything the column imposes.
  normalizedContent String
  /// A digest of the content above, so "did this change" is one comparison
  /// rather than one of the largest strings in the database.
  contentHash       String
  /// When the page was last read successfully. Moves on every successful check,
  /// including the ones that found nothing new.
  lastCheckedAt     DateTime
  /// When the content last differed from what was here before, or null if it
  /// never has.
  ///
  /// **Null is what a first read leaves behind, and it is not a missing
  /// value.** Establishing a baseline is not observing a change: there was
  /// nothing to differ from, and setting this to the moment of the first fetch
  /// would report a change to somebody who had not been watching yet. It stays
  /// null until the page actually differs.
  ///
  /// Moves only when the baseline does, which is what makes "has anything
  /// happened lately" a question this can answer and `RunHistory` cannot.
  lastChangedAt     DateTime?
  /// When the baseline was first established, which is the first successful
  /// fetch. There is no `updatedAt`: it would say what `lastCheckedAt` already
  /// says, and `RunHistory` sets the precedent for a model whose timestamps are
  /// about the domain rather than about the row.
  createdAt         DateTime      @default(now())
  websiteSource     WebsiteSource @relation(fields: [websiteSourceId], references: [id], onDelete: Cascade)
}

/// How much of a rate-limited action an account has used, and since when.
///
/// **One row per account and scope, rewritten in place.** It is a counter, not
/// a log: nothing here says which requests were made or when each one arrived,
/// because nothing asks. A table of individual requests would grow with usage
/// and would need a retention policy that nothing has decided.
///
/// **The window is a fixed span measured from `windowStartedAt`, not a calendar
/// hour.** It starts on the first request that finds no live window and lasts
/// exactly `AI_DRAFT_WINDOW_MS` from that instant, so it depends on neither the
/// owner's timezone nor the clock's minute hand.
///
/// **In the database rather than in memory**, for the two reasons that decide
/// it: a limit kept in a process resets on every deploy and restart, and stops
/// being one limit at all the moment a second replica exists.
///
/// `scope` is a plain string narrowed by whoever writes it, the same as
/// `status`, `frequency` and `kind` are. Today there is exactly one value —
/// `worker-draft` (`AI_DRAFT_SCOPE`) — and adding another should be a constant
/// rather than a migration.
/// What a `discovery` worker looks for, one row per worker.
///
/// **Nothing in the application can create one yet.** `routineKinds` does not
/// contain `discovery`, so `isRoutineKind` refuses the value on the way in and
/// no worker can be saved as that kind — which means these two tables exist and
/// are reachable by nothing. That is deliberate: the shape is settled and
/// migrated before anything depends on it, so the release that turns the kind
/// on is a code change rather than a code change and a migration at once.
///
/// **The owner is the routine's and is not copied here.** `Routine.userId` is
/// the only place that says who anything belongs to; a second column saying it
/// would eventually disagree, and a source pointing at one account while its
/// worker points at another is a state worth making unrepresentable. Every
/// read and write reaches it through the relation — see `lib/discovery/repository.ts`.
model DiscoverySource {
  id         String   @id @default(cuid())
  routineId  String   @unique
  /// Which provider to ask. A plain String narrowed by `isDiscoverySourceKind`
  /// on the way out, the same shape as `kind`, `status` and `frequency` — so
  /// adding a provider is a line in code rather than a migration.
  source     String
  /// What to search for, as the owner wrote it.
  query      String
  /// How many items one run may choose. **Not how many are fetched**: the
  /// number of candidates asked for is a constant the owner does not set.
  maxResults Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  routine    Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
}

/// Something a discovery worker has already chosen, so it is not chosen again.
///
/// **Only what was selected.** "Do not show me what I picked yesterday" is the
/// requirement; "never show me anything I have ever scrolled past" is not. The
/// candidates a run saw and passed over are not recorded, which keeps this
/// table proportional to what was useful rather than to what was fetched.
///
/// **A record of a past choice, not a live mirror.** The video may since have
/// been renamed, made private, or removed; these columns say what it was when
/// it was chosen, and nothing goes back to check.
model DiscoverySeenItem {
  id          String    @id @default(cuid())
  routineId   String
  /// Provider-prefixed, so two sources cannot collide on an id that means
  /// different things to each — `youtube:<videoId>`. The prefix is here from
  /// the start because adding one later would mean rewriting existing rows.
  itemKey     String
  title       String
  author      String
  url         String
  /// Null when the source did not say. Never inferred.
  publishedAt DateTime?
  selectedAt  DateTime  @default(now())
  routine     Routine   @relation(fields: [routineId], references: [id], onDelete: Cascade)

  /// The last line of defence against choosing the same thing twice, and what
  /// makes a second run writing the same item safe rather than a conflict.
  @@unique([routineId, itemKey])
  /// The exclusion set is read per worker, newest first.
  @@index([routineId, selectedAt])
}

model RateLimitBucket {
  id              String   @id @default(cuid())
  /// The account the allowance belongs to. **The owner, not a session** — a
  /// window survives signing out, and signing back in does not reset it.
  userId          String
  /// Which allowance this is. See the note above on why it is not an enum.
  scope           String
  /// When the current window began. Everything is measured from here.
  windowStartedAt DateTime
  /// How many requests the current window has taken. Incremented by the
  /// database rather than read and written back — see `lib/rate-limit.ts`.
  count           Int
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One window per account and scope, and the key both writes address the row
  /// by. It is what makes two simultaneous first requests produce one row and
  /// one unique-constraint failure rather than two rows that each allow ten.
  @@unique([userId, scope])
}

/// The right to have one hand-started run in progress, held per account.
///
/// **A user-level slot, and deliberately not the worker-level lease.**
/// `Routine.executionOwner` decides whether *this worker* is already running;
/// this decides whether *this account* already has a manual run going, whatever
/// worker it belongs to. Both are held during the same execution and neither
/// replaces the other: without this one, an account could start as many runs as
/// it has workers, each of them perfectly legitimate on its own.
///
/// **Rows rather than a counter.** One row is one execution with one expiry, so
/// a process that dies leaves exactly one slot to lapse; a count would leave a
/// number nobody can correct, since nothing records what the missing decrement
/// was for. It is also what makes the limit a product decision rather than a
/// migration — raising it adds rows, not columns.
///
/// **Created on the first hand-started run and kept afterwards.** An account
/// that has never pressed Run has no row, exactly as one that has never asked
/// for a draft has no `RateLimitBucket`.
///
/// **Manual runs only.** Scheduled execution is bounded elsewhere — the tick
/// takes five workers at most and works through them one at a time — and is
/// never asked for a slot here.
model ManualRunSlot {
  /// The account the slot belongs to.
  userId     String
  /// Which of the account's slots this is, counting from zero. With a limit of
  /// one there is only ever slot `0`; the column exists so raising the limit is
  /// a constant and some more rows rather than a schema change.
  slotNumber Int
  /// Who holds it, as an opaque token minted per acquisition. Null means free.
  ///
  /// **What it protects is the release**: a run that overran its lease no
  /// longer holds the slot, and matching on this token is what stops it from
  /// freeing the run that took it over.
  owner      String?
  /// When the current holder's claim lapses, after which another may take it.
  /// Null means free.
  ///
  /// **Expiry is the whole of the recovery.** A process that dies mid-run never
  /// reaches its release, and nothing sweeps these rows.
  leaseUntil DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One row per account and slot, and the key acquisition addresses it by.
  @@id([userId, slotNumber])
}

/// When AutoOps may next fetch a page from this host.
///
/// **One row per hostname, for the whole platform.** Every other guard here is
/// an account's — how many drafts it may ask for, how many runs it may start —
/// because what those protect is AutoOps and its bill. This one protects
/// somebody else's website, and a site being fetched every second cannot tell
/// which accounts the requests came from. So there is deliberately no `userId`:
/// two accounts watching the same page share this row, and neither can spend
/// the other's turn twice over.
///
/// **The host is the key, exactly as the URL parser normalised it.** No scheme
/// (only http and https are watched at all), no port (only the standard ones
/// are), no path, and no attempt to group `www.example.com` with
/// `news.example.com` — telling which names belong to one owner needs the
/// Public Suffix List, and guessing it wrong makes unrelated sites on a shared
/// domain block each other.
///
/// **The value is a time, and that is the whole mechanism.** Taking a turn
/// moves it forward; nothing is held, so nothing has to be given back and a
/// process that dies mid-fetch leaves no lock behind. There is no TTL to
/// choose, no owner token, and no cleanup beyond the row itself — which lives
/// as long as the host is watched and is one row either way.
model DomainThrottle {
  /// The hostname, lowercased by `URL` and punycoded if it was not ASCII.
  host          String   @id
  /// The earliest instant a fetch of this host may begin.
  nextAllowedAt DateTime
}

/// What the owner has told Koqentra about the work, in their own words.
///
/// **This is the explicit half of Creator memory, and the only half a person
/// writes.** Three separate things are kept apart on purpose and this is the
/// first of them: what somebody stated (here), what they actually did
/// (`CreatorFeedback`), and what a model concluded from watching them
/// (`CreatorMemory`). Folding them together would let an inference overwrite a
/// declaration, which is the one direction that must never be possible — a
/// stated preference is true because it was stated, and no amount of observed
/// behaviour makes it false.
///
/// **One per account.** `userId` is unique rather than an ordinary index, so
/// the shape is enforced by the database instead of by whoever writes next.
/// Multiple profiles per account are one dropped constraint away if they are
/// ever wanted, and are not wanted now.
///
/// **No display name.** `User.name` and `User.image` already come from the
/// provider and are refreshed there; a second copy here would be a second
/// answer to the same question, stale from the moment it was written.
model CreatorProfile {
  id                String         @id @default(cuid())
  userId            String         @unique
  /// Who the writing is for, as the owner describes them.
  audience          String         @default("")
  /// What the owner is trying to achieve by publishing.
  goals             String         @default("")
  /// How it should sound — the instruction a draft is written under.
  voiceInstructions String         @default("")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentItems      ContentItem[]
  memory            CreatorMemory?
}

/// One piece of material the owner handed over to be judged.
///
/// **Given, not watched.** A `WebsiteSource` exists to be checked again and
/// again, and its whole point is whether it moved since last time; this is a
/// thing somebody chose to submit once. No hash, no snapshot, no baseline —
/// there is nothing here to compare against, because comparison is not what it
/// is for. That is why this carries no foreign key to `Routine` or
/// `WebsiteSource`, and why neither of them knows it exists.
///
/// **`userId` alongside `creatorProfileId`, deliberately.** The profile
/// already implies the owner, so this column is redundant on paper — and
/// `RunHistory` carries the same redundancy for the same reason: every read is
/// scoped by the owner directly, and a query that has to travel through a
/// parent to find out who something belongs to is a query that can be written
/// without doing so.
model ContentItem {
  id               String              @id @default(cuid())
  userId           String
  creatorProfileId String
  /// How the material arrived: "text" or "url". A plain string narrowed by
  /// `isCreatorSourceKind`, following `Routine.kind` and `status` rather than a
  /// database enum — adding a way in should not be a migration.
  sourceKind       String
  /// Where it came from, when it came from somewhere. Null for pasted text.
  sourceUrl        String?
  title            String?
  /// The material itself, as text.
  body             String
  createdAt        DateTime            @default(now())
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  creatorProfile   CreatorProfile      @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  decisions        EditorialDecision[]

  @@index([userId])
  @@index([creatorProfileId])
}

/// The judgement: whether this material is worth publishing on one channel.
///
/// **The decision is the event, and the draft is optional.** A `skip` says the
/// material is not worth a post and produces nothing to read; a `recommend`
/// produces a `ContentDraft`. Because half of all decisions may carry no
/// draft, this — not the draft — is what feedback answers. Hanging feedback
/// off the draft would leave a person unable to disagree with a `skip`, which
/// is exactly the disagreement worth hearing.
///
/// **`verdict` says what was decided, never how the run went.** There is no
/// `failed` here and there must not be one: a request that never reached a
/// model produced no judgement at all, and recording one would put a sentence
/// the model never wrote into the history the memory is derived from.
///
/// **One decision per channel per item.** The same material can be judged for
/// `x` and for `longform` separately — they are different questions — but
/// asking the same question twice is a second answer to overwrite, not a
/// second row.
model EditorialDecision {
  id            String           @id @default(cuid())
  userId        String
  contentItemId String
  /// "x", "reddit" or "longform". **`longform` is a shape, not a site**: note,
  /// Substack and a personal blog all want the same long piece, and naming one
  /// of them here would make the column wrong everywhere else.
  targetChannel String
  /// "recommend" or "skip".
  verdict       String
  /// Why, in the model's words — shown to the person deciding whether to agree.
  reason        String
  createdAt     DateTime         @default(now())
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentItem   ContentItem      @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  draft         ContentDraft?
  feedback      CreatorFeedback?

  @@unique([contentItemId, targetChannel])
  @@index([userId])
}

/// What the model wrote, exactly as it wrote it.
///
/// **Immutable, and that is the entire reason it is a separate row.** When
/// somebody edits a draft before publishing, the edit goes to
/// `CreatorFeedback.editedBody` and this is left alone. The pair — what was
/// proposed and what was actually wanted — is the most informative thing the
/// system ever sees about a person's taste, and overwriting this to store the
/// result would destroy precisely the half that carries the signal.
///
/// **Only a `recommend` has one.** The relation is one-to-one and optional
/// from the decision's side; nothing creates a draft for a `skip`.
model ContentDraft {
  id                  String            @id @default(cuid())
  userId              String
  editorialDecisionId String            @unique
  /// The proposed text. Never rewritten.
  body                String
  createdAt           DateTime          @default(now())
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  editorialDecision   EditorialDecision @relation(fields: [editorialDecisionId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// What the person did about a decision. A fact, not an opinion about one.
///
/// **It answers the decision, not the draft.** There is no foreign key to
/// `ContentDraft` here, and adding one would quietly re-introduce the problem
/// this shape exists to avoid: a `skip` has no draft, so feedback hung off the
/// draft could never disagree with one.
///
/// **Append-only.** A row here records something that happened at a moment,
/// and something that happened does not later become something else. Nothing
/// updates it; there is no undo in C1, and a change of mind would be a new
/// decision rather than a rewritten memory of the old one. The `@unique` holds
/// that to one answer per decision.
///
/// **The human half of memory.** `CreatorProfile` is what the owner said,
/// `CreatorMemory` is what a model concluded, and this is what they actually
/// did — the only one of the three that is evidence.
model CreatorFeedback {
  id                  String            @id @default(cuid())
  userId              String
  editorialDecisionId String            @unique
  /// "approve", "edit" or "reject". `approve` agrees with the decision — and a
  /// `skip` is a decision, so approving one is ordinary rather than a special
  /// case. `reject` disagrees with the decision itself.
  action              String
  /// What the person actually wanted, when they edited rather than agreed. The
  /// original stays in `ContentDraft.body`; the two together are the point.
  editedBody          String?
  /// Why, when they chose to say. Optional because being made to explain a
  /// rejection is how people stop rejecting things.
  reason              String?
  createdAt           DateTime          @default(now())
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  editorialDecision   EditorialDecision @relation(fields: [editorialDecisionId], references: [id], onDelete: Cascade)
  memoryEvidence      CreatorMemoryEvidence?

  @@index([userId])
}

/// What a model concluded from watching, kept apart from what it watched.
///
/// **Derived, and therefore disposable.** Everything here can be rebuilt from
/// `CreatorFeedback` and `CreatorProfile`, which is what makes it safe to
/// replace: a summary that turns out to be wrong is regenerated, and no fact
/// is lost in the process. That property only holds while the raw feedback
/// keeps living somewhere else, which is why the three kinds of memory are
/// three tables.
///
/// **One per profile, rewritten in place.** Not one per channel: the tendencies
/// worth remembering are mostly about the person rather than the site, and a
/// summary can say where they differ in its own words. Splitting the row by
/// channel is a later constraint if the summary ever proves too coarse.
///
/// `derivedFromCount` records how much evidence a summary was built from, so a
/// conclusion drawn from two decisions is not mistaken for one drawn from two
/// hundred.
model CreatorMemory {
  id               String         @id @default(cuid())
  userId           String
  creatorProfileId String         @unique
  /// The conclusion, in prose. Empty until something has been learned.
  summary          String         @default("")
  /// How many feedback events the summary represents.
  ///
  /// **Equal to the number of `CreatorMemoryEvidence` rows pointing at this
  /// summary — not an offset into an ordered history.** It used to mean "the
  /// oldest N answers", which assumed the oldest N never change. Nothing
  /// enforces that, so what it counts now is membership, and what says *which*
  /// answers is the evidence table. Here it is a displayed number and an
  /// optimistic-locking value.
  derivedFromCount Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  creatorProfile   CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  evidence         CreatorMemoryEvidence[]

  @@index([userId])
}

/// Which answers a summary actually represents.
///
/// One row means: this exact `CreatorFeedback` has been incorporated into this
/// `CreatorMemory`. **Bookkeeping and nothing else** — no draft, no edit, no
/// excerpt, no second copy of the summary. What it records is identity and a
/// relationship.
///
/// **It exists because a count cannot say which.** A summary described as "the
/// oldest N answers" is only correct while the oldest N stay the same, and
/// nothing makes them: `createdAt` has millisecond resolution and `id` is a
/// client-generated cuid, so a row can become visible after another and still
/// sort before it. When that happened, an offset of N pointed at a different
/// set — one answer silently dropped from the summary forever, another
/// summarised twice. Membership cannot drift that way: an answer is either
/// recorded here or it is not.
///
/// `creatorFeedbackId` is unique, so one answer can never be incorporated more
/// than once, and every relation cascades so no bookkeeping outlives what it
/// refers to.
model CreatorMemoryEvidence {
  id                String          @id @default(cuid())
  userId            String
  creatorMemoryId   String
  creatorFeedbackId String          @unique
  createdAt         DateTime        @default(now())
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  creatorMemory     CreatorMemory   @relation(fields: [creatorMemoryId], references: [id], onDelete: Cascade)
  creatorFeedback   CreatorFeedback @relation(fields: [creatorFeedbackId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([creatorMemoryId])
}

/// What an account is entitled to, and where that entitlement came from.
///
/// **One row per account, and its absence is an ordinary state.** An account
/// that has never activated a worker has nothing here, and that is not a
/// missing row — it is "no trial and no subscription yet". Creating a row to
/// represent nothing would make provisioning a billing concern, and it is not
/// one.
///
/// **`state` is Koqentra's own word, never a billing provider's.** A provider
/// reports what it knows about a payment; what a deployment does about that is
/// a decision this column holds. Copying a provider's vocabulary in here would
/// mean every reader of this row learns that provider's taxonomy, and changing
/// providers would mean rewriting rows rather than rewriting an adapter.
///
/// **Nothing reads this to decide whether a worker may run.** Not yet: see
/// `lib/entitlements/`.
model Subscription {
  id                     String    @id @default(cuid())
  /// The account. Unique because an account has one entitlement or none.
  userId                 String    @unique
  /// Which plan's allowances apply. Narrowed by `isPlan`, not by the database.
  plan                   String
  /// See `isSubscriptionState`. A string for the same reason `plan` is.
  state                  String
  /// When the trial began — the instant a worker of this account first became
  /// active. Null on an account that never had one.
  trialStartedAt         DateTime?
  /// When the trial ends.
  ///
  /// **Written down rather than derived**, so that changing how long a trial
  /// lasts cannot shorten or extend one already running.
  trialEndsAt            DateTime?
  /// When this account used its trial. **The whole of what makes a trial
  /// once-only**: it stays set after the trial ends, and after a plan is
  /// bought, because what was consumed was the offer rather than the time.
  trialConsumedAt        DateTime?
  /// When this account stopped being able to be offered a trial, and the fact
  /// that it did.
  ///
  /// **Not the same as `trialConsumedAt`, and deliberately a second column.**
  /// That one says the account took the offer up; this one says the offer is no
  /// longer available to it. An account given the beta allowance never had a
  /// trial — writing `trialConsumedAt` for it would be a lie about what it did —
  /// but it is not owed one either, and that is what this records.
  ///
  /// **It exists because every other signal moves.** The rule used to be read
  /// from `plan` and `source`, which is correct only while an account is still
  /// on the granted beta allowance: buying a plan changes both, and
  /// `Subscription.userId` is unique, so the row that said "beta" is gone
  /// rather than kept. An account that went beta → paid → cancelled would
  /// otherwise become eligible for a trial it was never owed.
  ///
  /// Null for the ordinary case: an account that may still be offered one.
  trialForfeitedAt       DateTime?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  /// The one worker allowed to email its owner on a plan that allows one.
  ///
  /// **A choice, and a plain column rather than a relation.** Null means no
  /// choice has been made, which is not the same as a worker that no longer
  /// exists — and a relation would have to decide which of those a deleted
  /// worker leaves behind.
  notificationWorkerId   String?
  /// How this entitlement was granted: "trial", "admin", or a provider's name.
  source                 String
  /// When a granted entitlement stops. Used by admin grants; null otherwise.
  expiresAt              DateTime?
  /// Provider identifiers. **Written and read only by a billing adapter**, and
  /// never handed to code that asks what an account may do.
  providerCustomerId     String?
  providerSubscriptionId String?
  /// The provider's own timestamp for the update these columns came from.
  /// What makes an out-of-order webhook discardable rather than applied.
  ///
  /// **Being replaced.** Judging a provider's updates by their own timestamps
  /// turned out not to work for at least one provider, whose event timestamps
  /// are whole seconds and whose delivery order is explicitly not guaranteed —
  /// so two distinct changes can be indistinguishable. `providerSyncedAt` and
  /// provider-current-state reconciliation replace it. Nothing new writes this.
  providerUpdatedAt      DateTime?
  /// When Koqentra last successfully reconciled this account against the
  /// provider's current state.
  ///
  /// **Observability only, and that restriction is the point.** It says when we
  /// last looked, which answers "has this account fallen out of sync" — and
  /// nothing else. It must never be compared to decide which of two
  /// observations is newer, to judge whether an event is stale, or to stand in
  /// for a provider-side version. Ordering is established by holding the
  /// reconciliation lease while fetching, not by any timestamp; using this
  /// column for it would quietly reintroduce the problem the lease exists to
  /// solve.
  providerSyncedAt       DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Finding the entitlements whose period has run out, which is the one query
  /// that does not start from an account.
  @@index([state, currentPeriodEnd])
}

/// One period's worth of allowance for one account.
///
/// **A period is the subscription's own cycle, not a calendar month.** An
/// account that starts paying on the 20th gets a whole allowance from the 20th;
/// resetting on the 1st would hand it two.
///
/// **`planAtStart` is recorded because it cannot be recovered.** A plan changed
/// mid-period leaves no trace of what the period was opened under, and that is
/// exactly what a question about a charge needs to know.
///
/// Nothing creates one of these during ordinary use yet.
model UsagePeriod {
  id          String         @id @default(cuid())
  userId      String
  periodStart DateTime
  periodEnd   DateTime
  /// The plan in force when this period opened. See above.
  planAtStart String
  createdAt   DateTime       @default(now())
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  counters    UsageCounter[]

  /// One period per account and start instant. What makes two simultaneous
  /// first requests produce one period and one constraint failure, rather than
  /// two periods that each carry a full allowance.
  @@unique([userId, periodStart])
  /// Finding the period an instant falls in, newest first.
  @@index([userId, periodEnd])
}

/// How much of one allowance a period has spent.
///
/// **`used` counts product units, not provider requests.** What a request costs
/// in units is decided where it is spent, so changing that later is a constant
/// rather than a migration — and the raw provider numbers stay in
/// `ProviderUsageEvent`, where changing the weighting cannot rewrite them.
///
/// **`limit` is a copy, on purpose.** The plan's number is in `lib/plans.ts`;
/// this is what that number was when the period opened, so a plan changed
/// mid-period cannot retroactively move a boundary somebody already ran into.
model UsageCounter {
  id       String      @id @default(cuid())
  periodId String
  /// Which allowance: see `isUsageKind`.
  kind     String
  used     Int
  limit    Int
  period   UsagePeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  /// One counter per period and kind, and the key the conditional update
  /// addresses the row by. See `lib/usage/consume.ts`.
  @@unique([periodId, kind])
}

/// What one call to a model actually used.
///
/// **Raw, normalised, and not a cost.** Prices change, cache pricing differs,
/// and a stored estimate would be a number nobody could correct afterwards. A
/// cost is derived from these rows and a pricing table later; what is kept here
/// is the only thing that cannot be recomputed.
///
/// **Separate from `RunHistory` because half of these have no run.** A draft is
/// a form somebody is looking at, and a Creator analysis is not a worker at all;
/// neither writes a run, and a column on `RunHistory` would have made those two
/// unrecordable. It also leaves room for a run that calls a model more than
/// once, which a column could not.
///
/// **Nothing writes to this table yet.**
///
/// **What is deliberately absent**: the prompt, the answer, the watched
/// address, the key, any header, the provider's raw response, and any
/// free-form provider error. Knowing what a call cost does not require keeping
/// what it said.
model ProviderUsageEvent {
  id               String   @id @default(cuid())
  userId           String
  occurredAt       DateTime
  /// Which part of Koqentra made the call. See `isUsageFeature`.
  feature          String
  /// Who was called. "anthropic" is the only one so far.
  provider         String
  /// The model as the provider names it.
  model            String
  /// **Null means unknown, zero means the provider said zero.** A failed call
  /// often reports no usage at all, and writing that down as 0 would make a
  /// call that cost something indistinguishable from one that cost nothing.
  inputTokens      Int?
  outputTokens     Int?
  cacheReadTokens  Int?
  cacheWriteTokens Int?
  /// "ok" or "error". See `isUsageOutcome`.
  outcome          String
  /// The run this call belonged to, when it belonged to one.
  ///
  /// **A plain column rather than a relation.** Drafts and Creator analyses
  /// have no run, so a relation would make the ordinary case the exception —
  /// and a cascade would delete the record of what something cost along with
  /// the record of what it did, which are two different things to keep.
  runId            String?
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// What one account spent, over a span.
  @@index([userId, occurredAt])
  /// What the deployment spent, over a span. The question a cost guard asks.
  @@index([occurredAt])
}

/// One thing a billing provider said happened to a subscription.
///
/// **Evidence, and the thing that makes a repeated callback harmless.** A
/// provider may deliver the same event twice, out of order, or long after it
/// happened; none of those may open a second period or reset a counter that has
/// already been spent against. `@@unique([provider, providerEventId])` is what
/// makes the second delivery a constraint failure rather than a second effect —
/// the same shape `UsagePeriod` already uses for two simultaneous first uses.
///
/// **Not `ProviderUsageEvent`, and deliberately a separate table.** That one
/// records what a call to a *model* cost, in tokens, so that a price table can
/// be applied to it later. This one records what a *billing provider* said about
/// an entitlement. They share no question, no lifecycle and no reader; merging
/// them would mean one table answering "what did this cost" and "why is this
/// account inactive" at once.
///
/// **Nothing here decides what an account may do.** Capability is worked out
/// from `Subscription` and the plan catalogue — see `computeEntitlement`, which
/// cannot reach this table and must never need to. What is stored here is how
/// the subscription came to say what it says.
///
/// **No provider's vocabulary appears in this table.** `kind` holds one of
/// Koqentra's own event names; a provider's own wording is translated by its
/// adapter and never stored. A column named after one provider's payload would
/// be a column the next provider has to pretend to have.
model BillingEvent {
  id              String   @id @default(cuid())
  /// Who said it: "stripe", "app-store", "play". A string for the same reason
  /// `plan` and `state` are — adding a provider should be a line of code rather
  /// than a migration.
  provider        String
  /// The provider's own id for this delivery. **Unique per provider, never
  /// globally**: two providers may each number an event `1`, and neither has
  /// any claim on the other's numbering.
  ///
  /// **Null on a row that no single delivery caused.** Reconciliation looks at
  /// the provider's current state and may answer several notifications — or
  /// none at all, on a sweep — with one observation; naming any one delivery as
  /// the cause would be inventing a causal claim, and inventing a value here
  /// would invent an idempotency identity along with it. The column stays only
  /// until the legacy writer is gone.
  providerEventId String?
  /// The account the event is about, resolved by the adapter from whatever the
  /// provider used to identify the customer.
  userId          String
  /// What happened, in Koqentra's words. See the provider-neutral event names
  /// in the billing design; a provider's own event type never appears here.
  kind            String
  /// When the provider says it happened. **Theirs, not ours** — it is what an
  /// out-of-order delivery has to be judged against, and a local clock would
  /// judge the order things arrived in instead.
  ///
  /// **Null on a reconciliation-origin row**, which has no such instant to
  /// record: what it knows is when Koqentra looked, and that is `observedAt`.
  /// Writing one into the other would be the false mapping this bridge exists
  /// to avoid.
  occurredAt      DateTime?
  /// When Koqentra received it. Kept beside `occurredAt` precisely because they
  /// can differ by a long way, and the gap is the first thing worth seeing when
  /// something arrived late.
  receivedAt      DateTime @default(now())

  /// When the reconciliation that applied this transition observed the
  /// provider's state.
  ///
  /// **Replacing `occurredAt`**, which asked the provider when something
  /// happened. What matters instead is when Koqentra looked and what it saw,
  /// because that is what the decision was actually made from.
  ///
  /// Nullable only while both the old writer and the new one have to exist;
  /// it becomes required once nothing writes `occurredAt`.
  observedAt      DateTime?
  /// The reconciliation run that applied this transition.
  ///
  /// **The truthful identity of a transition, once several provider
  /// notifications can be answered by a single look at provider state.** Three
  /// deliveries about one subscription are collapsed into one fetch; naming any
  /// one of them as the cause of what that fetch found would be inventing a
  /// causal claim. What caused it was the run.
  ///
  /// It also exists for runs no notification triggered — a sweep, or an
  /// operator asking for a resync — which is why it, rather than a receipt,
  /// is the identity.
  ///
  /// Nullable for the same reason as `observedAt`.
  reconciliationRunId String?
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// **The legacy idempotency key, as a constraint rather than a convention.**
  /// A second delivery of the same event cannot be written, so it cannot be
  /// processed twice.
  ///
  /// **Still true of the rows it applies to, and silent about the rest.**
  /// PostgreSQL treats nulls in a unique index as distinct from one another, so
  /// any number of reconciliation-origin rows — which leave `providerEventId`
  /// null — sit under this constraint without colliding, while every row the
  /// legacy writer produces is still refused a twin.
  @@unique([provider, providerEventId])
  /// **The identity of a reconciliation-origin transition.** A run derives at
  /// most one transition of each kind, so this is what stops a coding error
  /// writing the same one twice. Nulls being distinct is again what lets it
  /// coexist with the legacy rows, which carry no run.
  @@unique([reconciliationRunId, kind])
  /// One account's billing history, in order. The question support asks.
  @@index([userId, occurredAt])
}

/// One notification from a billing provider, recorded on arrival.
///
/// **Receiving a notification and applying a change are different facts, and
/// this table holds the first one.** `BillingEvent` means a domain transition
/// was applied; a row can only mean that, which is what makes it readable.
/// Notifications that changed nothing — a redelivery, a state already
/// converged, an event about a subscription this account has since replaced —
/// would make that table ambiguous in the one direction that matters, so they
/// are recorded here instead.
///
/// **Nothing here decides anything.** A row is evidence that a provider said
/// something and what was eventually made of it. What an account may do is
/// still worked out from `Subscription` and the plan catalogue.
///
/// **No payload, ever.** The provider's own object is not stored: it carries
/// customer names, card details and amounts that no question here needs, and a
/// column that existed would eventually be read by something that should not
/// know any of it. What is kept is identifiers and an outcome.
model ProviderEventReceipt {
  id                     String    @id @default(cuid())
  /// Who sent it: "stripe", "app-store", "play".
  provider               String
  /// The provider's own id for this delivery. Used for one thing only —
  /// recognising that the same delivery arrived twice. It says nothing about
  /// order, and nothing may read it as though it did.
  providerEventId        String
  /// The provider's own name for the kind of notification, kept as it was
  /// given. **Recorded, never branched on**: what to do is decided by fetching
  /// the provider's current state, not by which notification woke us up.
  providerEventType      String
  /// Which subscription at the provider this is about. **The unit of
  /// serialisation**, and the only field the reconciliation actually needs
  /// from a notification.
  providerSubscriptionId String
  providerCustomerId     String?
  /// When the provider says it happened.
  ///
  /// **Observability only.** At least one provider records this in whole
  /// seconds and states plainly that it must not be used to order events or to
  /// decide whether one was already handled. It is here so that a delivery gap
  /// can be seen, and for no other purpose.
  providerOccurredAt     DateTime?
  /// The provider API version the payload was rendered under. Kept so that a
  /// silent change in what a field means can be noticed rather than inferred
  /// from the damage.
  providerApiVersion     String?
  /// The account, once it could be resolved.
  ///
  /// **Nullable on purpose.** A notification whose account cannot be worked out
  /// is exactly the one somebody will need to look at, and a required column
  /// would leave nowhere to record it.
  userId                 String?
  receivedAt             DateTime  @default(now())
  /// The reconciliation run that took this receipt into its observation.
  ///
  /// **Written before the provider is fetched, not after.** It marks the set of
  /// notifications a run is answering for: anything arriving later has not been
  /// looked at yet and must not be treated as covered. A wall clock could not
  /// draw that line, because when a row was written and when it became visible
  /// are not the same instant.
  reconciliationRunId    String?
  /// Null until a run has answered for this receipt. Once set, it means a
  /// reconciliation that began after this receipt was durably recorded has
  /// completed.
  resolvedAt             DateTime?
  /// What became of it — applied, already converged, coalesced with others,
  /// superseded, or one of the refusals. See the billing design for the closed
  /// set.
  outcome                String?
  user                   User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// **Delivery idempotency, as a constraint rather than a convention.** A
  /// provider may send the same notification many times; the second insert
  /// fails, so it cannot be answered twice.
  @@unique([provider, providerEventId])
  /// Claiming a run's receipts, and finding what is still outstanding for one
  /// subscription.
  @@index([provider, providerSubscriptionId, resolvedAt])
  /// The sweeper's question: what is unanswered, oldest first.
  @@index([resolvedAt, receivedAt])
  /// One account's notifications, for whoever is looking into it.
  @@index([userId, receivedAt])
}

/// The serialisation point for reconciling one provider subscription.
///
/// **It exists because fetching provider state has to be serialised, not just
/// writing it.** Two handlers that each fetch and then queue for a row lock can
/// still apply their results in the wrong order: the lock makes the writes
/// orderly but says nothing about which fetch saw the newer world. Holding this
/// lease across the fetch is what makes a later run's observation no older than
/// an earlier one's.
///
/// **A lease rather than a database lock**, because the fetch is a network call
/// and no transaction should be open across one. It is an ordinary row with an
/// expiry, so a handler that dies releases it by running out of time rather
/// than by holding a connection hostage.
///
/// **`leaseToken` is a fence.** A run whose lease expired mid-fetch may still
/// be alive and about to write; it checks the token before applying and
/// discards its work if another run has taken over.
model BillingReconciliation {
  id                     String    @id @default(cuid())
  provider               String
  /// Together with `provider`, the thing being serialised. Not the account:
  /// one account can have an old subscription and a new one, and those are
  /// separate pieces of work.
  providerSubscriptionId String
  /// The account, once known. Null until a subscription has been bound.
  userId                 String?
  /// The oldest unanswered notification for this subscription, or null when
  /// there are none.
  ///
  /// **Derived rather than flagged.** A boolean marker can be left set or
  /// cleared wrongly and nothing shows it; this value is recomputed from the
  /// receipts themselves whenever they change, so it cannot drift, and it
  /// answers "how far behind are we" rather than only "is there work".
  pendingSince           DateTime?
  /// Who holds the lease. Also the identity of the run, and what
  /// `BillingEvent.reconciliationRunId` and `ProviderEventReceipt` carry.
  leaseToken             String?
  /// When the lease lapses and another run may take over.
  leaseUntil             DateTime?
  /// How many times a run has been started for this subscription.
  ///
  /// **Retry state belongs here rather than on a receipt.** What is retried is
  /// the reconciliation, not any one notification: several receipts are
  /// answered by a single run, so counting attempts per receipt would count the
  /// same work repeatedly.
  attempts               Int       @default(0)
  lastRunAt              DateTime?
  /// Short reason for the most recent failure, for whoever is looking at a
  /// subscription that has stopped converging. A sentence, never a payload.
  lastFailureReason      String?
  /// The run that first saw the provider report this subscription unpaid.
  ///
  /// **Why one observation is not enough.** Unpaid can go back to active at the
  /// provider, and no provider documents that two successive reads return
  /// states in order — so a single late read could revoke a subscription that
  /// has in fact been paid. Requiring two serialised runs to agree costs one
  /// sweep of delay against days already spent in grace, and that trade is
  /// worth making. Cleared as soon as any other state is observed.
  unpaidFirstSeenRunId   String?
  user                   User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// One row per provider subscription: the lease has nothing to serialise
  /// against otherwise.
  @@unique([provider, providerSubscriptionId])
  /// The sweeper's queue, oldest work first.
  @@index([pendingSince])
  /// Finding leases that have lapsed, so a dead run's work can be taken over.
  @@index([leaseUntil])
}
