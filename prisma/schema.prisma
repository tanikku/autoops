// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// A signed-in Google account. `id` is the provider account id (the JWT `sub`),
/// which is what every owned row is scoped by.
model User {
  id        String       @id
  email     String       @unique
  name      String?
  image     String?
  /// IANA zone the dashboard renders timestamps in, e.g. "Asia/Tokyo".
  /// Defaults to UTC so existing rows keep displaying exactly what they did
  /// before there was a setting to change.
  timezone  String       @default("UTC")
  createdAt DateTime     @default(now())
  routines  Routine[]
  runs      RunHistory[]
}

model Routine {
  id          String       @id @default(cuid())
  userId      String
  name        String
  description String       @default("")
  prompt      String       @default("")
  /// Free-text cadence label from before the UI derived one from `frequency`.
  /// No longer written or read; retained for compatibility with rows created
  /// earlier. Revisit when the scheduler gains a time of day — this column is
  /// then either dropped or replaced by the fields that carry it.
  schedule    String       @default("")
  status      String       @default("draft")
  frequency   String       @default("manual")
  nextRunAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs        RunHistory[]

  @@index([userId])
}

model RunHistory {
  id         String    @id @default(cuid())
  routineId  String
  /// Denormalised from the routine so runs can be scoped without a join.
  userId     String
  status     String    @default("running")
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  output     String    @default("")
  routine    Routine   @relation(fields: [routineId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([routineId])
  @@index([userId])
}
