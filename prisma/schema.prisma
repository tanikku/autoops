// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A signed-in Google account. `id` is the provider account id (the JWT `sub`),
/// which is what every owned row is scoped by.
model User {
  id             String            @id
  email          String            @unique
  name           String?
  image          String?
  /// IANA zone the dashboard renders timestamps in, e.g. "Asia/Tokyo".
  /// Defaults to UTC so existing rows keep displaying exactly what they did
  /// before there was a setting to change.
  timezone       String            @default("UTC")
  /// Language AutoOps uses for its own screens, "en" or "ja".
  ///
  /// A plain string rather than a database enum: adding a language should be a
  /// dictionary file and a line in `supportedLanguages`, not a migration. The
  /// application narrows it on the way in and falls back on the way out, the
  /// same as `status` and `frequency` do.
  ///
  /// **It says nothing about what a worker produces.** Instructions, watched
  /// pages and model output are the owner's own material and are never
  /// translated to match this.
  language       String            @default("en")
  createdAt      DateTime          @default(now())
  routines       Routine[]
  runs           RunHistory[]
  rateLimits     RateLimitBucket[]
  manualRunSlots ManualRunSlot[]
}

model Routine {
  id                  String         @id @default(cuid())
  userId              String
  name                String
  description         String         @default("")
  prompt              String         @default("")
  /// What kind of worker this is: `prompt` sends its prompt to the model,
  /// `website` fetches a page first and only involves the model when the page
  /// changed.
  ///
  /// **A plain string, narrowed in `toRoutine`, exactly as `status` and
  /// `frequency` are.** The alternative — an enum — would be the first in this
  /// schema and would make adding a kind a migration rather than a line in a
  /// type guard.
  ///
  /// The default is what makes this additive: every worker that existed before
  /// watchers did is a `prompt` worker, and Postgres fills them in without a
  /// backfill.
  kind                String         @default("prompt")
  status              String         @default("draft")
  frequency           String         @default("manual")
  /// Time of day the worker runs, as minutes into the day in the owner's
  /// timezone: 0 is midnight, 540 is 09:00. Null keeps whatever time the
  /// pending slot already had, which is how every worker behaved before a time
  /// could be chosen.
  runAtMinutes        Int?
  /// Day of the week a weekly worker runs, in the owner's timezone: 0 is
  /// Sunday through 6 is Saturday, matching JavaScript's own numbering so no
  /// conversion sits between this column and the arithmetic. Null keeps
  /// whichever weekday the pending slot already falls on.
  runAtWeekday        Int?
  /// Day of the month a monthly worker runs, in the owner's timezone: 1 to 31.
  /// A day past the end of a month runs on that month's last day instead, and
  /// the month after returns to the chosen one. Null keeps whichever day the
  /// pending slot already falls on.
  runAtDay            Int?
  nextRunAt           DateTime?
  /// Who currently holds the right to execute this worker, as an opaque token
  /// minted per acquisition. Null means nobody does.
  ///
  /// **Execution ownership, not the scheduled slot.** `nextRunAt` says which
  /// slot has been taken; this says whether a run is already under way, and it
  /// applies to hand-started runs as much as to scheduled ones.
  ///
  /// It is neither a job id nor an execution id, and nothing outside the lease
  /// primitive reads it — a run is identified by its `RunHistory` row.
  executionOwner      String?
  /// When the current holder's claim lapses, after which another may take it.
  ///
  /// **Expiry is what keeps a lost process from blocking a worker forever.** A
  /// run that dies without releasing leaves the columns set; the next attempt
  /// takes over once this instant has passed. Nothing sweeps them.
  ///
  /// The consequence is that this is *not* an unconditional guarantee of one
  /// execution at a time: a run outliving its lease can overlap with the one
  /// that takes over. What is guaranteed is that the older holder cannot
  /// release the newer one's claim — see `lib/execution-lease.ts`.
  executionLeaseUntil DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs                RunHistory[]
  /// The watched page, when this is a `website` worker. Absent on every other
  /// kind, which is why the relation is optional rather than the `kind` column
  /// being the only thing that says so.
  websiteSource       WebsiteSource?

  @@index([userId])
  /// The scheduler's only query: `status = 'active' AND nextRunAt <= now()`,
  /// ordered by `nextRunAt`. Equality first and the range second is what lets
  /// one index serve both the filter and the ordering — reversed, the range
  /// column would stop the scan from using `status` to narrow anything.
  ///
  /// Every tick runs this across all tenants, so without an index the cost
  /// grows with the number of workers on the platform rather than with the
  /// number that are due.
  @@index([status, nextRunAt])
}

model RunHistory {
  id           String    @id @default(cuid())
  routineId    String
  /// Denormalised from the routine so runs can be scoped without a join.
  userId       String
  status       String    @default("running")
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  /// What the model produced. **Only ever that** — a run that failed leaves it
  /// empty rather than borrowing it for a reason.
  output       String    @default("")
  /// Why a run failed, for whoever is looking into it. Null on every run that
  /// did not fail, which is what makes the two columns readable without
  /// consulting `status` first.
  ///
  /// **A diagnostic, not a message written for the person whose worker it
  /// is.** It carries whatever the failure said — a provider's own wording, or
  /// a database driver's — so it belongs on the execution's own page and not
  /// in a list someone is scanning.
  errorMessage String?
  routine      Routine   @relation(fields: [routineId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([routineId])
  @@index([userId])
}

/// The page a `website` worker watches, and the settings for watching it.
///
/// **Configuration, and only configuration.** What was last seen there lives in
/// `WebsiteSnapshot`, which is a separate table for a reason: this row is small,
/// edited by a person, and read whenever a worker is shown, while that one holds
/// up to a couple of megabytes and is read only while a run is happening.
/// Together in one table, every screen that wanted the URL would carry the page
/// with it.
///
/// One row per worker at most — `routineId` is unique — so a worker watches one
/// page. Several workers watching the same page, in one account or across
/// accounts, is ordinary, which is why `url` carries no unique constraint.
///
/// **There is no owner column here, deliberately.** `RunHistory` carries one
/// because runs are listed per account and the join would be on every activity
/// page; nothing lists sources that way, so the same denormalisation would buy
/// nothing and would make `Routine.userId = A` with `WebsiteSource.userId = B`
/// a state the database is willing to hold. Ownership has one source of truth,
/// and it is the routine.
model WebsiteSource {
  id        String           @id @default(cuid())
  /// Unique because a worker watches one page. The relation being optional on
  /// the other side is what lets a `prompt` worker have none. **It is also the
  /// tenant key**: who owns this is whoever owns the routine.
  routineId String           @unique
  /// The address as the owner wrote it. **Validated when it is saved and again
  /// before every fetch** — storing it is not a promise that it is still safe
  /// to visit, and nothing here may be fetched without going through
  /// `lib/watcher`.
  url       String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  routine   Routine          @relation(fields: [routineId], references: [id], onDelete: Cascade)
  snapshot  WebsiteSnapshot?
}

/// What the watched page looked like when it was last successfully read.
///
/// **The baseline a change is measured against, and nothing else.** It is not
/// run history: there is one row per source, overwritten in place, so watching a
/// page for a year costs the same as watching it for a day. A table of every
/// version would grow without limit and would need a retention policy that
/// nothing has decided.
///
/// **The row does not exist until the first successful fetch.** That absence is
/// the "no baseline yet" state — there is no half-made snapshot to represent,
/// which is why the only nullable column here is one with a meaning of its own.
///
/// **`RunHistory.output` is not this.** That column holds what the model
/// produced; this holds what the site served. Reading a snapshot out of run
/// history would also lose it on the first failed run.
model WebsiteSnapshot {
  id                String        @id @default(cuid())
  websiteSourceId   String        @unique
  /// The page reduced to the text a comparison runs on — **not raw HTML**,
  /// which is deliberately never stored: it is larger, and none of the
  /// comparison or the summary needs it.
  ///
  /// `String` is `TEXT` on PostgreSQL, so the ceiling is the fetch limit
  /// (`MAX_RESPONSE_BYTES`) rather than anything the column imposes.
  normalizedContent String
  /// A digest of the content above, so "did this change" is one comparison
  /// rather than one of the largest strings in the database.
  contentHash       String
  /// When the page was last read successfully. Moves on every successful check,
  /// including the ones that found nothing new.
  lastCheckedAt     DateTime
  /// When the content last differed from what was here before, or null if it
  /// never has.
  ///
  /// **Null is what a first read leaves behind, and it is not a missing
  /// value.** Establishing a baseline is not observing a change: there was
  /// nothing to differ from, and setting this to the moment of the first fetch
  /// would report a change to somebody who had not been watching yet. It stays
  /// null until the page actually differs.
  ///
  /// Moves only when the baseline does, which is what makes "has anything
  /// happened lately" a question this can answer and `RunHistory` cannot.
  lastChangedAt     DateTime?
  /// When the baseline was first established, which is the first successful
  /// fetch. There is no `updatedAt`: it would say what `lastCheckedAt` already
  /// says, and `RunHistory` sets the precedent for a model whose timestamps are
  /// about the domain rather than about the row.
  createdAt         DateTime      @default(now())
  websiteSource     WebsiteSource @relation(fields: [websiteSourceId], references: [id], onDelete: Cascade)
}

/// How much of a rate-limited action an account has used, and since when.
///
/// **One row per account and scope, rewritten in place.** It is a counter, not
/// a log: nothing here says which requests were made or when each one arrived,
/// because nothing asks. A table of individual requests would grow with usage
/// and would need a retention policy that nothing has decided.
///
/// **The window is a fixed span measured from `windowStartedAt`, not a calendar
/// hour.** It starts on the first request that finds no live window and lasts
/// exactly `AI_DRAFT_WINDOW_MS` from that instant, so it depends on neither the
/// owner's timezone nor the clock's minute hand.
///
/// **In the database rather than in memory**, for the two reasons that decide
/// it: a limit kept in a process resets on every deploy and restart, and stops
/// being one limit at all the moment a second replica exists.
///
/// `scope` is a plain string narrowed by whoever writes it, the same as
/// `status`, `frequency` and `kind` are. Today there is exactly one value —
/// `worker-draft` (`AI_DRAFT_SCOPE`) — and adding another should be a constant
/// rather than a migration.
model RateLimitBucket {
  id              String   @id @default(cuid())
  /// The account the allowance belongs to. **The owner, not a session** — a
  /// window survives signing out, and signing back in does not reset it.
  userId          String
  /// Which allowance this is. See the note above on why it is not an enum.
  scope           String
  /// When the current window began. Everything is measured from here.
  windowStartedAt DateTime
  /// How many requests the current window has taken. Incremented by the
  /// database rather than read and written back — see `lib/rate-limit.ts`.
  count           Int
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One window per account and scope, and the key both writes address the row
  /// by. It is what makes two simultaneous first requests produce one row and
  /// one unique-constraint failure rather than two rows that each allow ten.
  @@unique([userId, scope])
}

/// The right to have one hand-started run in progress, held per account.
///
/// **A user-level slot, and deliberately not the worker-level lease.**
/// `Routine.executionOwner` decides whether *this worker* is already running;
/// this decides whether *this account* already has a manual run going, whatever
/// worker it belongs to. Both are held during the same execution and neither
/// replaces the other: without this one, an account could start as many runs as
/// it has workers, each of them perfectly legitimate on its own.
///
/// **Rows rather than a counter.** One row is one execution with one expiry, so
/// a process that dies leaves exactly one slot to lapse; a count would leave a
/// number nobody can correct, since nothing records what the missing decrement
/// was for. It is also what makes the limit a product decision rather than a
/// migration — raising it adds rows, not columns.
///
/// **Created on the first hand-started run and kept afterwards.** An account
/// that has never pressed Run has no row, exactly as one that has never asked
/// for a draft has no `RateLimitBucket`.
///
/// **Manual runs only.** Scheduled execution is bounded elsewhere — the tick
/// takes five workers at most and works through them one at a time — and is
/// never asked for a slot here.
model ManualRunSlot {
  /// The account the slot belongs to.
  userId     String
  /// Which of the account's slots this is, counting from zero. With a limit of
  /// one there is only ever slot `0`; the column exists so raising the limit is
  /// a constant and some more rows rather than a schema change.
  slotNumber Int
  /// Who holds it, as an opaque token minted per acquisition. Null means free.
  ///
  /// **What it protects is the release**: a run that overran its lease no
  /// longer holds the slot, and matching on this token is what stops it from
  /// freeing the run that took it over.
  owner      String?
  /// When the current holder's claim lapses, after which another may take it.
  /// Null means free.
  ///
  /// **Expiry is the whole of the recovery.** A process that dies mid-run never
  /// reaches its release, and nothing sweeps these rows.
  leaseUntil DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One row per account and slot, and the key acquisition addresses it by.
  @@id([userId, slotNumber])
}
